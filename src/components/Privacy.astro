---
import SectionHead from './SectionHead.astro';
import { privacy as p } from '../content/copy';
---
<section id="privacy" class="sec" aria-labelledby="h-privacy"
  data-state-on={p.stateOn} data-state-off={p.stateOff} data-toast-offline={p.toastOffline} data-toast-online={p.toastOnline}>
  <div class="wrap">
    <SectionHead id="h-privacy" idx={p.idx} eyebrow={p.eyebrow} h2={p.h2} lede={p.lede} />

    <div class="house-wrap" id="houseWrap">
      <svg class="house" viewBox="0 0 1000 640" role="img" aria-labelledby="houseT houseD">
        <title id="houseT">{p.svgTitle}</title>
        <desc id="houseD">{p.svgDesc}</desc>
        <line class="h-floor" x1="40" y1="612" x2="960" y2="612"/>
        <path class="h-outline" d="M120 612 V262 L500 70 L880 262 V612"/>
        <path class="net-line" d="M520 430 C 600 350, 760 250, 858 152"/>
        <g class="cloud">
          <path d="M826 150 h96 a26 26 0 0 0 4 -51 a34 34 0 0 0 -62 -16 a24 24 0 0 0 -38 18 a25 25 0 0 0 0 49 z"/>
          <path d="M818 166 L 934 64"/>
        </g>

        <!-- the home network: tablet to router to laptop. A packet runs along it once the walker arrives. -->
        <path class="lan" id="lanPath" d="M274 334 C 274 420, 420 435, 500 435 S 730 446, 730 519"/>
        <circle class="lan-pkt" id="packet" r="6" cx="274" cy="334"/>
        <g id="hTab" data-stop data-visit>
          <rect class="dev" x="196" y="284" width="156" height="100" rx="12"/>
          <rect class="dev-in" x="205" y="293" width="138" height="82" rx="6"/>
          <circle cx="330" cy="304" r="4" fill="#34C759"/>
        </g>
        <g class="mk"><circle cx="274" cy="420" r="17"/><text x="274" y="426" text-anchor="middle">1</text></g>

        <g id="hRouter" data-stop data-visit>
          <rect class="dev" x="440" y="418" width="120" height="34" rx="10"/>
          <circle cx="470" cy="435" r="2.5" fill="#636366"/><circle cx="484" cy="435" r="2.5" fill="#636366"/><circle cx="498" cy="435" r="2.5" fill="#636366"/>
        </g>
        <g class="mk"><circle cx="500" cy="490" r="17"/><text x="500" y="496" text-anchor="middle">2</text></g>

        <g id="hLap" data-stop data-visit>
          <rect class="dev" x="652" y="470" width="156" height="98" rx="8"/>
          <rect class="dev-in" x="661" y="479" width="138" height="80" rx="4"/>
          <rect class="dev" x="634" y="568" width="192" height="9" rx="4"/>
        </g>
        <g class="mk"><circle cx="730" cy="446" r="17"/><text x="730" y="452" text-anchor="middle">3</text></g>
      </svg>
      <ol class="legend">
        {p.legend.map(([n, a, b]) => <li class:list={[{ off: !n }]}><span class="lg-n" aria-hidden="true">{n || '×'}</span><span><b>{a}</b> {b}</span></li>)}
      </ol>
    </div>

    <div class="switch-row">
      <button class="switch" id="unplug" role="switch" aria-checked="false" type="button"><span class="track"><span class="knob"></span></span>{p.toggle}</button>
      <p id="netState" aria-live="polite">{p.stateOn}</p>
      <p class="fine switch-note">{p.toggleNote}</p>
    </div>

    <div class="truths rv">
      {p.truths.map((t) => <div class="truth"><p class="tag">{t.tag}</p><h3>{t.h}</h3><p>{t.p}</p></div>)}
    </div>
  </div>
</section>
