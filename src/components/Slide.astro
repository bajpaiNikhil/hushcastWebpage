---
interface Props { fit?: 'slice' | 'meet'; done?: boolean }
const { fit = 'meet', done = false } = Astro.props;
---
<svg class="slide" viewBox="0 0 320 200" preserveAspectRatio={`xMidYMid ${fit}`} aria-hidden="true">
  <rect width="320" height="200" fill="#0E0E10"/>
  <rect x="26" y="26" width="118" height="10" rx="5" fill="#2A2A2E"/>
  <rect x="26" y="44" width="76" height="8" rx="4" fill="#1F1F23"/>
  <path class:list={['ink', { done }]} pathLength="1" d="M44 158 C 74 96, 116 86, 146 124 S 214 176, 252 106"/>
  <path class:list={['ink', 'k2', { done }]} pathLength="1" d="M236 104 L254 104 L250 122"/>
</svg>
